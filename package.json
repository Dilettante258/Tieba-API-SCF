{
	"name": "@tieba/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "bun build ./src/index.ts --outdir=out --target=bun",
		"build:node": "bun build ./src/index.ts --outdir=out --target=node",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"hono": "^4.6.8",
