{
	"name": "@tieba/api",
	"version": "3.1.1",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "bun build ./src/index.ts --outdir=out --target=bun",
		"build:node": "rm -rf out && esbuild ./src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=out/index.js",
		"build:worker": "rm -rf out-worker && esbuild ./src/worker.ts --bundle --platform=node --format=esm --target=node22 --alias:undici=./node_modules/tieba.js/dist/shims/undici.js --outfile=out-worker/worker.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.4",
		"@hono/standard-validator": "^0.2.2",
		"@scalar/hono-api-reference": "^0.9.44",
		"@tieba/db": "workspace:*",
		"effect": "^3.14.11",
		"hono": "^4.6.8",
		"hono-openapi": "^1.2.0",
		"tieba.js": "workspace:*",
		"zod": "^3",
		"zod-openapi": "^4"
	},
	"devDependencies": {
		"@types/node": "^24",
		"esbuild": "^0.27.3",
		"wrangler": "^4"
	}
}
