		"@scalar/hono-api-reference": "^0.5.172",
		"effect": "^3.14.11",
		"@tieba/sdk": "workspace:*",
		"@tieba/db": "workspace:*",
		"dotenv": "^16.4.5"
	},
	"devDependencies": {
		"tsx": "^4.19.2",
		"esbuild": "^0.25.0",
		"@types/node": "^24"
	}
